    "qa:interviewApplicantType": "npx tsx scripts/step-interview-applicant-type-qa.ts",
    "qa:interviewApplicantType:dry": "npx tsx scripts/step-interview-applicant-type-qa.ts --dry",
    "qa:diagnosisTaxonomy": "npx tsx scripts/diagnosis-taxonomy-qa.ts",
    "qa:diagnosisScoring": "npx tsx scripts/diagnosis-scoring-qa.ts",
    "qa:examDiagnosis": "npx tsx scripts/exam-diagnosis-scoring-qa.ts",
    "qa:diagnosis": "npm run qa:diagnosisScoring && npm run qa:diagnosisTaxonomy && npm run qa:examDiagnosis",
    "qa:careerMatching": "npx tsx scripts/qa-career-matching.ts",
