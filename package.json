{
  "name": "paid-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "qa:rateLimit": "npx tsx --tsconfig tsconfig.realtime-test.json scripts/career-gd-rate-limit-qa.ts",
    "qa:step15": "npx tsx scripts/step15-qa.ts",
