# ─────────────────────────────────────────────────────────────
# 環境変数サンプル（プレースホルダのみ。実値は .env.local / Vercel に設定する）
# 値はすべてダミー。本ファイルに本物の secret を書かないこと。
# ─────────────────────────────────────────────────────────────

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase (受験版・共有) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase (就活版 CAREER 専用) ---
# 就活版ログイン（email OTP）/ career_accounts が使う専用プロジェクト。
# fallback ポリシー: development/test（NODE_ENV!=='production'）でのみ、未設定時に上の共有
#   NEXT_PUBLIC_SUPABASE_* / SUPABASE_SERVICE_ROLE_KEY へ read-only・一方向で fallback する。
#   production では fallback 禁止。未設定なら career client は無効（auth 無効 / mirror no-op）で
#   共有/受験版 Supabase へは接続しない。本番は必ず下記 3 つを設定すること。
# service role key は server-only。NEXT_PUBLIC_ を付けない。実値はコード/docsに書かず .env.local / Vercel にのみ設定する。
NEXT_PUBLIC_CAREER_SUPABASE_URL=https://your-career-project-ref.supabase.co
NEXT_PUBLIC_CAREER_SUPABASE_ANON_KEY=your-career-anon-key
CAREER_SUPABASE_SERVICE_ROLE_KEY=your-career-service-role-key

# --- GD Phase2 マルチGD 合言葉 (server-only) ---
# 6桁参加コードの HMAC pepper（deterministic hash 用）。未設定なら SUPABASE_SERVICE_ROLE_KEY を fallback。
# サーバ専用シークレット。NEXT_PUBLIC_ を付けない。実値はコード/docsに書かず .env.local / Vercel にのみ設定する。
CAREER_GD_JOIN_CODE_PEPPER=your-random-long-secret

# --- Personal Memory shadow-write canary (P16-G) ---
# master flag（public・build-time inline）。未設定/false=OFF（default deny）。true/1/yes で ON。
NEXT_PUBLIC_CAREER_PERSONAL_MEMORY_SHADOW_WRITE_ENABLED=
# canary allowlist（server-only。NEXT_PUBLIC_ を付けない＝client bundle 非混入）。
# USER_IDS: comma-separated authenticated user UUID（実 UUID はコード/docsに書かず .env.local / Vercel にのみ設定）。
# 空/未設定/不正形式混入/上限超過は default deny。
CAREER_PERSONAL_MEMORY_CANARY_USER_IDS=
# SECTIONS: comma-separated（base / self_analysis / es / interview のみ許可。wildcard / all / unknown は deny）。
CAREER_PERSONAL_MEMORY_CANARY_SECTIONS=

# --- 自己分析まとめ生成 job pilot (STEP-CAREER-GENJOB) ---
# fail-closed。**Preview のみ**で設定し Production は未設定（=OFF）のまま。実 UUID はコード/docsに書かない。
# 明示 'true' のときだけ pilot ON。それ以外/未設定は OFF。
CAREER_SELF_ANALYSIS_JOB_PILOT_ENABLED=
# canary allowlist（server-only。comma-separated authenticated user UUID）。
# 空/未設定/malformed/wildcard(* / all) は「誰も job 経路に入れない」。掲載 UUID の exact 一致のみ対象。
CAREER_SELF_ANALYSIS_JOB_CANARY_USER_IDS=

# --- Company Prefetch（志望企業 → Company Data Spine 先読み・既定 OFF）---
#
# 目的: ユーザーが志望企業名を入力した時点で、その企業の identity を確定し、公式サイト等から
#   最低限の企業情報（出典 URL 付き）を先回りで集めて Company Data Spine に保存する。
#   企業研究 / ES / 面接 / 志望動機 / Career AI はそれを共通基盤として読む。
#
# ★ Company Matching / Company Identity UI とは **完全に独立**。
#   CAREER_COMPANY_MATCHING_ENABLED も CAREER_COMPANY_IDENTITY_ENABLED も OFF のまま、
#   下の flag だけで Prefetch を有効化できる（/career/company の UI は 404 のまま）。
#
# 有効化の順序（段階的に開ける）:
#   1. まず CAREER_COMPANY_PREFETCH_ENABLED=true + CANARY_USER_IDS に自分の UUID だけ
#      → identity 解決（DB 内照合のみ）まで動く。**outbound I/O はゼロ**。
#   2. 次に CAREER_COMPANY_PREFETCH_EXTERNAL_FETCH_ENABLED=true
#      → 公的 registry / 検索 / 公式サイト取得が動きだす。
#
# ⚠ 事前に supabase/career_company_identity_apply.sql と
#   supabase/career_company_official_facts_apply.sql を Project B へ適用しておくこと
#   （未適用でも壊れないが、何も保存されず unavailable のままになる）。
#
# 受理値は厳密に 'true' のみ。未設定 = OFF。
CAREER_COMPANY_PREFETCH_ENABLED=
# 外部ネットワーク取得の独立 kill switch（上が ON でもこれが OFF なら outbound I/O ゼロ）。
CAREER_COMPANY_PREFETCH_EXTERNAL_FETCH_ENABLED=
# canary allowlist（server-only。comma-separated authenticated user UUID）。
# 空/未設定/malformed/wildcard(* / all) は「誰も prefetch されない」= fail-closed。
CAREER_COMPANY_PREFETCH_CANARY_USER_IDS=

# 公的法人 registry（既定: 国税庁 法人番号システム Web-API）。
#   未設定なら registry provider は呼ばれず、identity は「既存企業への紐付けのみ」になる
#   （＝ free-text だけで全ユーザー共有の企業マスタに行を作らせない安全側の挙動）。
#   ★ APP_ID は secret。出典 URL には載せない実装になっている。
CAREER_CORPORATE_REGISTRY_APP_ID=
CAREER_CORPORATE_REGISTRY_BASE_URL=

# 公式ドメイン探索に使う検索 provider（provider 非依存。未設定なら domain discovery を行わない）。
#   ENDPOINT に {query} を含めると URL 埋め込み、無ければ QUERY_PARAM で付与する。
CAREER_COMPANY_SEARCH_ENDPOINT=
CAREER_COMPANY_SEARCH_API_KEY=
CAREER_COMPANY_SEARCH_AUTH_HEADER=
CAREER_COMPANY_SEARCH_QUERY_PARAM=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_BASIC=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_PREMIUM=price_xxxxxxxxxxxx

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Sentry（エラートラッキング）
#   - 送信が有効になるのは NODE_ENV=production のときだけ（lib/sentry/options.ts）。
#     dev/preview では enabled=false / sample rate≈0 のため、未設定でも動作に影響なし。
#   - DSN は2系統:
#       SENTRY_DSN            … server / edge 用（サーバ専用。ブラウザに露出させない）。
#       NEXT_PUBLIC_SENTRY_DSN … client(ブラウザ)用（NEXT_PUBLIC_ 接頭辞が必須）。
#     通常は同一プロジェクトの同一 DSN 値を両方に設定してよい。
#   - ORG / PROJECT / AUTH_TOKEN は build 時の source map upload 用（runtime 未使用）。
#     未設定なら upload を skip するだけで build は失敗しない。
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxx

# ── 受験タイプ診断 9タイプ版 feature flag（STEP-DIAGNOSIS-MIGRATION）──
# /diagnosis を legacy 4タイプ ⇄ 新 9タイプ で切替える。build 時に inline されるため
# 切替後は再 build / 再 deploy が必要。
#   "true" / "1" / "yes" → 9タイプ版を有効化。
#   未設定 / 上記以外     → legacy 4タイプ版（既定・安全側）。問題時はこの値を外せば即ロールバック。
NEXT_PUBLIC_EXAM_DIAGNOSIS_ENABLED=

# ── 機能別データ連動 AI 面接 feature flag（STEP-INTERVIEW-AI-TYPE）──
# /interview/ai のタイプ選択（自己分析/活動/志望理由書/マッチング/小論文ベース面接）+
# データ欠如誘導 + 履歴の type 表示を切替える。build 時に inline されるため切替後は再 build/再 deploy。
#   "true" → 新機能（6タイプ選択UI）を有効化。Preview / 開発環境で検証用に設定する。
#   未設定 / 'true' 以外 → 従来のフリー面接のみ（既定・本番安全側）。一般ユーザーに新UIは一切出ない。
NEXT_PUBLIC_ENABLE_INTERVIEW_SOURCE_TYPES=

# ── AI 面接 音声入力（STT）設定（STEP-INTERVIEW-AI-VOICE / server-only）──
# 音声回答は録音 → /api/interview-ai/stt で文字起こし → 既存の text answer として保存する。
# 音声ファイルは保存しない（処理後に破棄）。STT 失敗時は保存も課金もせずテキスト入力にフォールバック。
#   INTERVIEW_AI_STT_PROVIDER=openai のときだけ OpenAI Whisper で文字起こしする（未設定 = STT 無効）。
#   未設定なら UI は録音に進めず常にテキスト回答（既存挙動）。Preview 検証時のみ設定する。
INTERVIEW_AI_STT_PROVIDER=
OPENAI_API_KEY=
# 任意。既定 'whisper-1'。
INTERVIEW_AI_STT_MODEL=

# ── AI 面接 質問読み上げ（TTS）設定（STEP-INTERVIEW-AI-TTS / server-only）──
# AI 質問テキストを /api/interview-ai/tts で音声化し、ブラウザで一時再生する（再生後破棄）。
# 音声ファイル・音声 URL は保存しない。TTS 失敗時は保存も課金もせず、質問はテキストで続行できる。
# TTS は面接回数を増やさない（課金は既存どおり text answer 保存時の 1セッション1カウントのみ）。
#   INTERVIEW_AI_TTS_PROVIDER=openai のときだけ OpenAI TTS で読み上げる（未設定 = 読み上げ無効）。
#   未設定なら UI は読み上げコントロールを出さず、従来どおりテキスト質問のみ（既存挙動）。
INTERVIEW_AI_TTS_PROVIDER=
# 任意。既定 'gpt-4o-mini-tts'。
INTERVIEW_AI_TTS_MODEL=
# 任意。面接官らしい落ち着いた声。既定 'alloy'（圧迫面接モードでも声色は変えない）。
INTERVIEW_AI_TTS_VOICE=
# 任意。読み上げ速度 [0.25, 4.0]。既定 0.95（早口すぎない）。
INTERVIEW_AI_TTS_SPEED=

# ── リアルタイム音声面接（WebRTC / STEP-INTERVIEW-AI-REALTIME）──
# /interview/ai/realtime の新モード。**まだ一般公開しない**。既定で完全 OFF。
# server 最終ゲート（これが 'true' のときだけ token route が OpenAI client_secret を発行）。
#   本番 passai.jp では **未設定のまま**（= 発行不可 / Realtime OFF）。検証は Preview でのみ true にする。
REALTIME_INTERVIEW_ENABLED=
# client 表示 flag（'true'/'1'/'yes'）。未設定なら /interview/ai/realtime は「利用できません」表示。
#   本番 passai.jp では **未設定のまま**（vercel.app Preview の ?realtime=1 も passai.jp では無効）。
NEXT_PUBLIC_ENABLE_REALTIME_INTERVIEW=
# 任意。開発者 allowlist（カンマ区切り user id）。非空なら対象 user のみ token 発行可。
REALTIME_DEV_USER_IDS=
# 任意。realtime モデル ID。既定 'gpt-realtime-mini'。
INTERVIEW_AI_REALTIME_MODEL=
# 任意。realtime 音声。既定 'alloy'。
INTERVIEW_AI_REALTIME_VOICE=
# OpenAI-Safety-Identifier ハッシュ用 salt（sha256(userId+salt)）。Realtime を使う環境では設定推奨。
REALTIME_SAFETY_ID_SALT=

# ============================================================
# 本番（passai.jp）env マトリクス — STEP1 時点の方針
#   ※ 変数名は上記の正式名を使うこと（REALTIME_ENABLED / SOURCE_TYPES_ENABLED は誤り＝無効）。
#
#   ターン制 AI 面接を「音声込み」で公開する（ON にするもの）:
#     NEXT_PUBLIC_ENABLE_INTERVIEW_SOURCE_TYPES=true   ← 音声/タイプ選択UI を有効化（passai.jp は env のみが有効化経路）
#     INTERVIEW_AI_STT_PROVIDER=openai                 ← STT（Whisper）を有効化。未設定だと音声不可
#     OPENAI_API_KEY=（設定済み）                       ← STT/TTS/Realtime 共通
#     INTERVIEW_AI_TTS_PROVIDER=openai                 ← （任意）AI 質問の読み上げを有効化
#
#   リアルタイム音声面接を「まだ公開しない」（未設定のまま＝OFF）:
#     REALTIME_INTERVIEW_ENABLED          → 未設定
#     NEXT_PUBLIC_ENABLE_REALTIME_INTERVIEW → 未設定
#   （導線リンクも無いため直 URL 以外で到達不可。直 URL で来ても client は無効カード / token は 403）
# ============================================================

# --- GD lobby rate limit（STEP-GD-20-K・任意） ---
#   公開GDロビー create/join の rate limit（user 単位・複数 window）。
#   production/preview では Upstash Redis REST を設定すると複数インスタンス間で共有される。
#   未設定なら in-memory fallback（プロセス内・インスタンス毎。起動時に警告あり）。
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io      # 任意。未設定なら in-memory
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token        # 任意。実値は .env.local / Vercel に設定
#   rate limit を無効化するテスト/ローカル用フラグ（**本番では設定しないこと**。既定=有効）。
#   CAREER_GD_RATE_LIMIT_DISABLED=1

# --- Cron 共通シークレット（既存 cron ＋ GD cleanup cron・STEP-GD-22） ---
#   /api/cron/*（reconcile-subscriptions / presentation-cleanup / gd-cleanup）は
#   `Authorization: Bearer ${CRON_SECRET}` のみ許可（fail-closed：未設定なら全部 401）。
#   Vercel Cron は設定時に自動でこの header を付与する。手動実行例:
#     curl -s -H "Authorization: Bearer $CRON_SECRET" "https://<host>/api/cron/gd-cleanup?dryRun=true"
#   GD cleanup の TTL は既定値（waiting 60分 / active 180分 / queue 終端 7日）。
#   必要なら query で上書き可: ?waitingTtlMin= / ?activeTtlMin= / ?queueTtlDays=
CRON_SECRET=your-cron-secret

# --- Data Spine Layer 4/5 production integration（P17-C・すべて既定 OFF / NOT READY） ---
#   ⚠ これらは限定 canary 用の gate。値は空 / false のみをコミットする（実 UUID / secret を書かない）。
#   ⚠ readiness flag（server-authoritative・NEXT_PUBLIC 不可）。全項目 true でのみ通電可（既定 NOT READY）。
#   CAREER_DATA_SPINE_READY_TARGET_PROJECT=
#   CAREER_DATA_SPINE_READY_IDENTITY_STRATEGY=
#   CAREER_DATA_SPINE_READY_TABLE_PLACEMENT=
#   CAREER_DATA_SPINE_READY_COHORT_THRESHOLD=
#   CAREER_DATA_SPINE_READY_RETENTION=
#   CAREER_DATA_SPINE_READY_REVOKE_DELETE_SLA=
#   CAREER_DATA_SPINE_READY_EXPLICIT_SHARE_CONSENT_VERSION=
#   CAREER_DATA_SPINE_READY_COMMERCIAL_USE=
#   CAREER_DATA_SPINE_READY_CONFIDENTIALITY_POLICY_VERSION=
#   CAREER_DATA_SPINE_READY_MODERATION_OWNER=
#   CAREER_DATA_SPINE_READY_TAKEDOWN_PROCESS=
#   CAREER_DATA_SPINE_READY_OFFICIAL_SOURCE_VERIFICATION=
#   feature flags（既定 OFF）。canary allowlist は 1 名の UUID のみ・wildcard 禁止・既定 empty。
#   CAREER_AGGREGATED_INSIGHT_READ_ENABLED=
#   CAREER_AGGREGATED_INSIGHT_CONSULTATION_ENABLED=
#   CAREER_AGGREGATED_INSIGHT_CANARY_USER_IDS=
#   CAREER_COMPANY_KNOWLEDGE_READ_ENABLED=
#   CAREER_COMPANY_KNOWLEDGE_RESEARCH_ENABLED=
#   CAREER_COMPANY_KNOWLEDGE_CANARY_USER_IDS=
#   P17-E synthetic-only mode（既定 true。'false' でも real mode は有効化されない=本 series で BLOCKED）。
#   CAREER_AGGREGATED_INSIGHT_SYNTHETIC_ONLY=

# ── 企業マッチング（初回リリース対象外・既定 OFF）────────────────────────────
#   企業マッチングは初回リリースから延期中。コード / DB / 型 / QA はすべて温存してあり、
#   **env を設定しないこと自体が OFF**（未設定 = 非公開）。Production では何も設定しなくてよい。
#   受理値は厳密に 'true' のみ（'1' / 'yes' は OFF 扱い）。build 時に固定されるため要再デプロイ。
#
#   再開するときは 2 本セットで設定する（片方だけでも安全側に倒れるが、機能としては半端になる）:
#     CAREER_COMPANY_MATCHING_ENABLED=            … 実行権限（server-only・最終権限）
#                                                    OFF: /career/matching は 404、API も 404
#     NEXT_PUBLIC_CAREER_COMPANY_MATCHING_ENABLED= … UI 導線の表示（Home / マイページ / GD 結果）
#                                                    ★ こちらだけ ON にしても実行は解禁されない
